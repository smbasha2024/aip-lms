# Copy to frontend/.env.local. Public values only.
# Origin only: API client appends /api/v1 exactly once.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Employee Leave Management
# E2E runner setting (not exposed through NEXT_PUBLIC_*).
E2E_BASE_URL=http://127.0.0.1:13000
# Separate backend configured with APP_ENV=test and TEST_DATABASE_URL.
E2E_API_URL=http://127.0.0.1:18000

# Optional remote Playwright server for restricted host environments (runner only).
E2E_BROWSER_WS_ENDPOINT=
