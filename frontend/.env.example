# New checkout: copy to frontend/.env.local. Preserve any existing local configuration.
# Public values only: NEXT_PUBLIC_* is compiled into the browser bundle.
# Origin only; the API client appends /api/v1. Rebuild when this changes.
# Use the same API origin at build time and server startup for CSP consistency.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Employee Leave Management
# E2E_* and database credentials belong to the runner environment, not this file.
# See docs/TESTING.md for the isolated browser setup.
