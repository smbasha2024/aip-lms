# Reference for backend settings; put actual values in repository-root .env.
# This file is not independently loaded; do not maintain duplicate real env files.
APP_ENV=development
DATABASE_URL=
TEST_DATABASE_URL=
ORG_TIMEZONE=Asia/Kolkata
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Development seeds only; 12..128 characters, supplied locally. No default passwords.
SEED_EMPLOYEE_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_ADMINISTRATOR_PASSWORD=
