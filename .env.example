# Copy to root .env and set values locally. Never commit .env.
# Backend loads root .env explicitly; frontend uses frontend/.env.local.
APP_ENV=development
ORG_TIMEZONE=Asia/Kolkata
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Required backend URL: postgresql+psycopg://USER:PASSWORD@localhost:5432/aip_lms_dev
DATABASE_URL=
# Separate test URL; never reuse development/production for destructive tests.
TEST_DATABASE_URL=

# Docker Compose development database. Set the password locally before running.
POSTGRES_DB=aip_lms_dev
POSTGRES_USER=aip_lms_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Test service is enabled only with --profile test.
TEST_POSTGRES_DB=aip_lms_test
TEST_POSTGRES_USER=aip_lms_test
TEST_POSTGRES_PASSWORD=
TEST_POSTGRES_PORT=5433
# Opaque server sessions need no JWT/SECRET_KEY setting in v1.

# Development seeds only; 12..128 characters, supplied locally. No default passwords.
SEED_EMPLOYEE_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_ADMINISTRATOR_PASSWORD=
