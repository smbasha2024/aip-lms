# New checkout: copy to root .env; preserve existing private configuration. Never commit .env.
# Process environment overrides this file. Keep all example secrets blank.
# Quote raw passwords containing # in dotenv; percent-encode reserved characters
# in DATABASE_URL/TEST_DATABASE_URL password components (for example # -> %23).
# Backend loads root .env explicitly; frontend uses frontend/.env.local.
APP_ENV=development
ORG_TIMEZONE=Asia/Kolkata
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Required backend URL: postgresql+psycopg://USER:PASSWORD@localhost:5432/aip_lms_dev
DATABASE_URL=
# Separate test URL: use a different database name containing test.
# APP_ENV=test selects this URL; never reuse development/production for destructive tests.
TEST_DATABASE_URL=

# Compose development database. These values must agree with DATABASE_URL.
# Set the password locally before running. Editing it does not rotate an existing DB role.
POSTGRES_DB=aip_lms_dev
POSTGRES_USER=aip_lms_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Test service is enabled only with --profile test; match TEST_DATABASE_URL.
TEST_POSTGRES_DB=aip_lms_test
TEST_POSTGRES_USER=aip_lms_test
TEST_POSTGRES_PASSWORD=
TEST_POSTGRES_PORT=5433
# Opaque server sessions need no JWT/SECRET_KEY setting in v1.

# Development seeds only; 12..128 characters, supplied locally. No default passwords.
SEED_EMPLOYEE_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_ADMINISTRATOR_PASSWORD=

# Production: APP_ENV=production, separate DATABASE_URL, explicit HTTPS CORS origins,
# injected credentials and an approved provisioning/recovery procedure. Never run dev seeds.
# See docs/RELEASE_READINESS.md; local Compose is not a production deployment.
