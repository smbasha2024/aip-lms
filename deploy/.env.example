# The initializer writes these to private root .env.staging, never root .env.
# Do not substitute development or production credentials.
STAGING_POSTGRES_PASSWORD=
STAGING_DATABASE_URL=
# Independent 12..128-character passwords for optional synthetic local accounts.
STAGING_SEED_EMPLOYEE_PASSWORD=
STAGING_SEED_MANAGER_PASSWORD=
STAGING_SEED_ADMINISTRATOR_PASSWORD=
